# https://ghostty.org/docs/config/keybind/reference

# Config generated by Ghostty Config
# https://ghostty.zerebos.com

theme = noctalia
shell-integration = fish
clipboard-read = allow
mouse-hide-while-typing = true
focus-follows-mouse = true
window-inherit-working-directory = true
shell-integration-features = true
link-previews = true
link-url = true

####################################
# KEYBINDINGS
####################################

keybind = ctrl+shift+r=reload_config

# Clipboard
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

# Close tab
keybind = ctrl+w=close_surface

# New tab
keybind = ctrl+alt+enter=new_tab
keybind = ctrl+enter=new_split:auto

# Command palette
keybind = ctrl+shift+p=toggle_command_palette

# Window/pane navigation
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
